# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Comma-separated user IDs who can use owner-only commands
OWNERS=

# Database
DB_PATH=./data/bot.sqlite

# Optional: default prefix for message commands (slash commands are recommended)
DEFAULT_PREFIX=!

# Logging
LOG_LEVEL=info

# AI Chat (OpenAI-compatible API — works with OpenRouter, OpenAI, local models)
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=anthropic/claude-sonnet-4
AI_SYSTEM_PROMPT=You are Otter, a friendly and helpful Discord bot. Keep responses concise and conversational. Use markdown formatting when appropriate.
